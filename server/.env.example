NODE_ENV=development
PORT=4000

# Data stores (docker compose up -d mongo redis)
MONGO_URI=mongodb://127.0.0.1:27017/warroom
REDIS_URL=redis://127.0.0.1:6379

# Auth. Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-please-123456
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false

# URLs
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Seconds to wait before paging the next person, for SEV1,SEV2,SEV3,SEV4.
# Demo values are tiny. Production example: 300,600,900,1800
ESC_SECONDS=20,40,60,90

# Demo data: creates six users and two resolved incidents on first boot.
# Turn this OFF in production.
SEED_DEMO=true
DEMO_PASSWORD=tidewater
# Used when SEED_DEMO=false and the database has no users yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email. Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tidewater <alerts@tidewater.dev>

# SMS (Twilio). Leave empty to log texts to the console instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
